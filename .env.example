# FileBox configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# App
APP_NAME=FileBox
ENV=development
PORT=8000

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=DB_USER
DB_PASS=DB_PASS
DB_NAME=filebox

# JWT (use long random hex strings in production)
JWT_SECRET=JWT_SECRET
JWT_REFRESH_SECRET=JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Filesystem storage (relative to project root / CWD)
STORAGE_PATH=storage
# Max size for direct upload in bytes (above this -> chunked upload)
UPLOAD_MAX_DIRECT=10485760
# Chunk size for chunked upload in bytes
CHUNK_SIZE=10485760

# Default per-user storage quota in bytes (0 = unlimited). 100 GB = 107374182400.
DEFAULT_STORAGE_QUOTA=107374182400

# Enable the standalone admin config page and swagger.
HAS_ADMIN_PAGE=true

# Server-side disk encryption master key (32 bytes, base64/hex/raw).
# This key is required; file bytes are encrypted with it before being written to disk.
FILEBOX_ENCRYPTION_KEY=FILEBOX_ENCRYPTION_KEY

# Rate limiter
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
