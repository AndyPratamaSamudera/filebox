# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Go ---
/bin/
backend/bin/
backend/filebox
backend/filebox.exe
*.exe
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# --- Embedded frontend (generated at build time) ---
backend/internal/web/static/*
!backend/internal/web/static/.gitkeep

# --- Frontend ---
frontend/node_modules/
frontend/build/
frontend/.svelte-kit/
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/package-lock.json
frontend/pnpm-lock.yaml

# --- Swag generated docs are committed so the binary builds without the swag CLI.
#     Regenerate via `make swagger` after editing handler annotations. ---

# --- Storage user data (never commit) ---
storage/users/*
storage/chunks/*
storage/thumbnails/*
storage/temp/*
storage/trash/*
!storage/**/.gitkeep

# --- Logs ---
*.log

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- ZCode ---
.zcode/
